# Copy to .env and edit. Never commit .env.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://bedboard:change-me@db:5432/bedboard
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-32-bytes
APP_URL=http://192.168.1.10:3001
PORT=3001
RESERVATION_MINUTES=30
DISCHARGE_ALERT_HOURS=4
IDLE_LOGOUT_MINUTES=15
RETENTION_DAYS=365
PUBLIC_PAGE_ENABLED=false
# Shown in the footer of the home page (leave empty to hide)
REPO_URL=
CONTACT_EMAIL=
BACKUP_PASSPHRASE=replace-with-a-strong-passphrase
